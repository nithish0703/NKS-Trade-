EXCHANGE_BASE_URL=https://fapi.binance.com
DATABASE_URL=sqlite+aiosqlite:///./data/smc_engine.db
LOG_LEVEL=INFO
SCANNER_INTERVAL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=10
MAX_CONCURRENT_SCANS=5
ENVIRONMENT=development
ENABLE_SIGNAL_PERSISTENCE=true
ENABLE_REJECTION_ANALYTICS=true
DUPLICATE_SIGNAL_RETENTION_SECONDS=3600
DUPLICATE_SIGNAL_MAXIMUM_ENTRIES=10000
CANDIDATE_BUFFER_MAXIMUM_SIZE=1000
STORAGE_FAILURE_IS_FATAL=false

# Dynamic Liquidity + Open Interest coin discovery. When disabled
# (default), the scanner uses the static 10-pair list in
# app/config/pairs.py, unchanged from prior behavior. When enabled, the
# scanner instead scans every USDT perpetual whose Open Interest AND
# 24h turnover both meet the configured minimums below -- no fixed
# "top N" cap unless PAIR_DISCOVERY_MAXIMUM_PAIRS is set. The pair list
# refreshes automatically in the background on PAIR_DISCOVERY_INTERVAL_SECONDS;
# a failed or empty refresh always keeps the previous list.
DYNAMIC_PAIR_DISCOVERY_ENABLED=false
PAIR_DISCOVERY_INTERVAL_SECONDS=900
PAIR_DISCOVERY_MINIMUM_OPEN_INTEREST_USDT=5000000
PAIR_DISCOVERY_MINIMUM_TURNOVER_24H_USDT=10000000
# Leave unset for no limit (every qualifying pair is scanned). Set to a
# positive integer to re-enable a "top N" cap, ranked by turnover.
PAIR_DISCOVERY_MAXIMUM_PAIRS=
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_REQUEST_TIMEOUT_SECONDS=10
TELEGRAM_MAX_RETRIES=2
TELEGRAM_RETRY_DELAY_SECONDS=1
TELEGRAM_DISABLE_WEB_PAGE_PREVIEW=true
DASHBOARD_API_ENABLED=true
DASHBOARD_ALLOWED_ORIGINS=http://localhost:5173
DASHBOARD_WEBSOCKET_ENABLED=true

# Signal outcome monitor: periodically checks EVERY CONFIRMED signal's
# live price (one bulk ticker fetch per cycle) against its
# take_profit/stop_loss/timeout and records the outcome; also mirrors
# WIN/LOSS onto dashboard_status for a signal that is dashboard-ACTIVE
# at close time. Runs standalone inside `python main.py scan` (whenever
# ENABLE_SIGNAL_PERSISTENCE=true) as well as inside the dashboard API
# (whenever DASHBOARD_API_ENABLED=true) -- outcome tracking works with
# either process alone, and a DB-backed lease ensures only one of them
# does the polling work per cycle if both are run at once against the
# same DATABASE_URL.
SIGNAL_OUTCOME_MONITOR_ENABLED=true
SIGNAL_OUTCOME_MONITOR_INTERVAL_SECONDS=60
